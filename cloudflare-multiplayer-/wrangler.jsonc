{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quai-vat-pho-multiplayer-edge-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://nrotjdwhsqaaypboazmw.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_bd3WU9TtQg2yzpWIoX5ykg__NZjCbLQ"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
